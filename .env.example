# Server
TOKENFOLD_API_KEY=            # when set, POST /v1/tokenfold requires `Authorization: Bearer <key>`
TOKENFOLD_PORT=8080           # used by `make dev` / `make dev-vllm`

# vLLM (or any OpenAI-compatible /v1/completions with prompt_logprobs)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=                   # empty: first model from /models
VLLM_API_KEY=EMPTY

# Model cache: keep weights on the external SSD (the Makefile exports this by default)
HF_HUB_CACHE="/Volumes/External SSD 1TB/huggingface/hub"
TOKENFOLD_LLAMA_MODEL=        # empty: unsloth Qwen3-4B-Instruct-2507 Q4_K_M
